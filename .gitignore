# pyenv
#   For a library or package, you might want to share your .python-version.
#   For an app, this is usually fine to prevent git tracking.
# .python-version

# pipenv
#   According to pypa/pipenv#598, it is recommended to include Pipfile.lock in version control.
#   However, in case of collaboration, if used in a multi-platform environment, the lock file might cause issue
# Pipfile.lock

# poetry
#   Similar to Pipfile.lock, poetry.lock can be included in version control, but may be excluded if preferred.
# poetry.lock

